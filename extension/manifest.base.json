{
  "manifest_version": 3,
  "name": "UzSpell — oʻzbekcha imlo va transliteratsiya",
  "version": "1.4.0",
  "description": "Oʻzbek tili uchun 100% oflayn imlo va grammatika tekshiruvi: brauzerdagi inputlarni avtomatik tekshiradi, xatolar tagiga chizadi. Lotin–kirill transliteratsiya ham bor.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UzSpell — imlo va transliteratsiya",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.bundle.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
