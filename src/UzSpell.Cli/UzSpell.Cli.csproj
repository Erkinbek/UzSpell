<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>uzspell</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\UzSpell.App\uzspell.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>UzSpell</Product>
    <Company>Erkin Pardayev</Company>
    <Copyright>© 2026 Erkin Pardayev. Lugʻatlar: uz-hunspell (GPL).</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UzSpell.Core\UzSpell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\uz-hunspell\uz_UZ.aff" Link="dictionaries\uz_UZ.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ.dic" Link="dictionaries\uz_UZ.dic" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ_Cyrl.aff" Link="dictionaries\uz_UZ_Cyrl.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ_Cyrl.dic" Link="dictionaries\uz_UZ_Cyrl.dic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
