<Window x:Class="UzSpell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UzSpell.App"
        mc:Ignorable="d"
        Title="UzSpell — oʻzbekcha imlo tekshiruvchi (oflayn)"
        Height="720" Width="1150" MinHeight="420" MinWidth="700"
        Loaded="OnLoaded">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Click="OnOpen" ToolTip="Matn (.txt) yoki Word (.docx) faylini ochish" Padding="8,4">📂 Ochish</Button>
                <Button Click="OnSave" ToolTip="Matnni .txt sifatida saqlash" Padding="8,4">💾 Saqlash</Button>
                <Separator/>
                <TextBlock Text="Yozuv:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox x:Name="CmbScript" Width="80" SelectedIndex="0" SelectionChanged="OnScriptChanged">
                    <ComboBoxItem Content="Avto"/>
                    <ComboBoxItem Content="Lotin"/>
                    <ComboBoxItem Content="Kirill"/>
                </ComboBox>
                <Separator/>
                <Button Click="OnCheckWordDoc" Padding="8,4"
                        ToolTip="Microsoft Word'da ochiq turgan hujjatni tekshirib, xato soʻzlarni qizil toʻlqinli chiziq bilan belgilaydi">
                    📝 Word hujjatini tekshirish
                </Button>
                <Button Click="OnClearWordMarks" Padding="8,4"
                        ToolTip="Word hujjatidagi qizil toʻlqinli belgilashlarni olib tashlaydi">
                    🧹 Word belgilarini tozalash
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="LblStatus" Text="Lugʻat yuklanmoqda…"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LblStats" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="370" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Editor" Grid.Column="0"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="16" FontFamily="Segoe UI" Padding="10"
                     TextChanged="OnTextChanged"
                     ContextMenuOpening="OnEditorContextMenuOpening"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

            <DockPanel Grid.Column="2" Margin="6">
                <TextBlock DockPanel.Dock="Top" x:Name="LblPanelTitle" Text="Xatolar"
                           FontWeight="Bold" FontSize="14" Margin="2,2,2,6"/>
                <ListBox x:Name="LstErrors" SelectionChanged="OnErrorSelected"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}"
                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayWord}" FontWeight="Bold"
                                               Foreground="{Binding WordBrush}" FontSize="14"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Message}" Foreground="#555" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding MessageVisibility}"/>
                                <TextBlock Text="{Binding SuggestionsHint}" Foreground="Gray" FontSize="11"
                                           Visibility="{Binding HintVisibility}"/>
                                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,4,0,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="0,0,4,4" Padding="7,3"
                                                    Click="OnSuggestionClick"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Eʼtiborsiz" Padding="7,3" Margin="0,0,4,0"
                                            ToolTip="Bu soʻzni shu sessiyada xato deb hisoblamaslik"
                                            Click="OnIgnoreClick"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <Button Content="➕ Lugʻatga" Padding="7,3"
                                            ToolTip="Soʻzni shaxsiy lugʻatga qoʻshish (doimiy saqlanadi)"
                                            Click="OnAddToDictClick"
                                            Visibility="{Binding DictButtonVisibility}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
