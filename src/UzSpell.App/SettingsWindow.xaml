<Window x:Class="UzSpell.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UzSpell — sozlamalar"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Yozuv" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbScript" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="Avto-aniqlash"/>
                <ComboBoxItem Content="Faqat lotin"/>
                <ComboBoxItem Content="Faqat kirill"/>
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="ChkGrammar" Grid.Row="1" Margin="0,0,0,10"
                  Content="Grammatika qoidalarini tekshirish"/>

        <CheckBox x:Name="ChkAllCaps" Grid.Row="2" Margin="0,0,0,14"
                  Content="BOSH HARFLI qisqartmalarni (AQSH, BMT) ham tekshirish"/>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Takliflar soni:" FontWeight="Bold"/>
                <TextBlock x:Name="LblMax" Text="6" Margin="6,0,0,0" FontWeight="Bold" Foreground="SteelBlue"/>
            </DockPanel>
            <Slider x:Name="SldMax" Minimum="1" Maximum="15" TickFrequency="1"
                    IsSnapToTickEnabled="True" Width="260" HorizontalAlignment="Left"
                    ValueChanged="OnMaxChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   VerticalAlignment="Bottom"
                   Text="Sozlamalar %APPDATA%\UzSpell\settings.json fayliga saqlanadi va dastur qayta ochilganda tiklanadi."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Bekor qilish" Width="100" Padding="6,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Saqlash" Width="100" Padding="6,4" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
