    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\uz-hunspell\uz_UZ.aff" Link="dictionaries\uz_UZ.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ.dic" Link="dictionaries\uz_UZ.dic" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ_Cyrl.aff" Link="dictionaries\uz_UZ_Cyrl.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uz-hunspell\uz_UZ_Cyrl.dic" Link="dictionaries\uz_UZ_Cyrl.dic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
