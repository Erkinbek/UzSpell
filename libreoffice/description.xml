<?xml version="1.0" encoding="UTF-8"?>
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink">

  <identifier value="uz.pardayev.uzspell.dictionaries"/>
  <version value="1.0.0"/>

  <dependencies>
    <OpenOffice.org-minimal-version value="3.4" d:name="OpenOffice.org 3.4"/>
  </dependencies>

  <display-name>
    <name lang="uz">UzSpell — oʻzbek tili imlo lugʻati (lotin va kirill)</name>
    <name lang="en">UzSpell — Uzbek spelling dictionary (Latin and Cyrillic)</name>
  </display-name>

  <publisher>
    <name xlink:href="https://github.com/Erkinbek/UzSpell" lang="uz">Erkin Pardayev</name>
    <name xlink:href="https://github.com/Erkinbek/UzSpell" lang="en">Erkin Pardayev</name>
  </publisher>

  <extension-description>
    <src lang="uz" xlink:href="desc-uz.txt"/>
    <src lang="en" xlink:href="desc-en.txt"/>
  </extension-description>

  <registration>
    <simple-license accept-by="admin" default-license-id="this">
      <license-text xlink:href="LICENSE.txt" lang="en" license-id="this"/>
    </simple-license>
  </registration>

