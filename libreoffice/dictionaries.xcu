<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    oor:name="Linguistic" oor:package="org.openoffice.Office">
  <node oor:name="ServiceManager">
    <node oor:name="Dictionaries">

      <!-- Oʻzbek (lotin) imlo lugʻati -->
      <node oor:name="HunSpellDic_uz_UZ" oor:op="fuse">
        <prop oor:name="Locations" oor:type="oor:string-list">
          <value>%origin%/uz_UZ.aff %origin%/uz_UZ.dic</value>
        </prop>
        <prop oor:name="Format" oor:type="xs:string">
          <value>DICT_SPELL</value>
        </prop>
        <prop oor:name="Locales" oor:type="oor:string-list">
          <value>uz uz-UZ uz-Latn-UZ</value>
        </prop>
      </node>

      <!-- Oʻzbek (kirill) imlo lugʻati -->
      <node oor:name="HunSpellDic_uz_UZ_Cyrl" oor:op="fuse">
        <prop oor:name="Locations" oor:type="oor:string-list">
          <value>%origin%/uz_UZ_Cyrl.aff %origin%/uz_UZ_Cyrl.dic</value>
        </prop>
        <prop oor:name="Format" oor:type="xs:string">
          <value>DICT_SPELL</value>
        </prop>
        <prop oor:name="Locales" oor:type="oor:string-list">
          <value>uz-Cyrl uz-Cyrl-UZ</value>
        </prop>
      </node>

    </node>
  </node>
</oor:component-data>
